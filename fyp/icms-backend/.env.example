# Local PostgreSQL (default port 5432). Create role+DB: bash scripts/init_postgres.sh
DATABASE_URL=postgresql://icms:icms@localhost:5432/icms
# If you use your own Linux user as DB owner, set DATABASE_URL accordingly, e.g.:
# DATABASE_URL=postgresql://YOUR_LINUX_USER@localhost:5432/icms
# Quick test without Postgres:
# DATABASE_URL=sqlite:///./icms.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50
USE_S3=false
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated). Add :5174 if Vite picks another port.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Dev only: allow any port on localhost / 127.0.0.1 (set false in production).
# CORS_RELAX_LOCAL_DEV=true
